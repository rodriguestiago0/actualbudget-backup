# Copy this file to `.env`, fill in your values and mount it at `/.env` in the
# container. Environment variables set on the container take precedence.
#
# One NAME=value per line. Values are read literally, nothing is expanded.
# Use single quotes for values with spaces or special characters, such as
# passwords: ACTUAL_BUDGET_PASSWORD='pa$$ word'. A value that contains a
# single quote can go in double quotes instead. In an unquoted value,
# " #" starts a comment.

# Actual server (required)
ACTUAL_BUDGET_URL='https://actual.example.com'
ACTUAL_BUDGET_PASSWORD=''
ACTUAL_BUDGET_SYNC_ID=''
# ACTUAL_BUDGET_E2E_PASSWORD=''

# Where to upload the backups (rclone remote)
# RCLONE_REMOTE_NAME='ActualBudgetBackup'
# RCLONE_REMOTE_DIR='/ActualBudgetBackup/'
# RCLONE_GLOBAL_FLAG=''

# Schedule and retention
# CRON='0 0 * * *'
# HEALTHCHECK_MAX_HOURS='26'
# BACKUP_FILE_SUFFIX='%Y%m%d_%H%M%S'
# BACKUP_KEEP_DAYS='0'
# TIMEZONE='UTC'

# Run as this user and group instead of root
# PUID='1000'
# PGID='1000'

# Archive
# ZIP_ENABLE='TRUE'
# ZIP_PASSWORD=''
# ZIP_TYPE='zip'

# Notifications, see docs/notifications.md
# NOTIFICATION_URLS='telegram://<bot-token>@telegram?chats=<chat-id>'
# NOTIFICATION_ON='success,failure'

# Pings for health check services, see docs/ping-notifications.md
# PING_URL=''
# PING_URL_WHEN_START=''
# PING_URL_WHEN_SUCCESS=''
# PING_URL_WHEN_FAILURE=''
